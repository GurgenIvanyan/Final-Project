@page "/my-playlists"
@using User.BlazorClient.Services
@using Microsoft.JSInterop
@inject UserApiClient Api
@inject AuthState Auth
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="mypl-page">
    <!-- HEADER -->
    <div class="mypl-header">
        <div>
            <h1 class="mypl-title">My playlists</h1>
            <p class="mypl-subtitle">
                Build your own mixes and save the sound of your sessions.
            </p>
        </div>

        @if (Auth.IsAuthenticated)
        {
            <button class="mypl-btn-new" @onclick="() => ShowCreate = true">
                <span class="mypl-btn-plus">+</span>
                New playlist
            </button>
        }
    </div>

    <!-- NOT AUTH -->
    @if (!Auth.IsAuthenticated)
    {
        <div class="mypl-glass-card mypl-auth-card">
            <div class="mypl-auth-icon">🔐</div>
            <div>
                <h2 class="mypl-card-title">Sign in to keep your playlists</h2>
                <p class="mypl-card-text">
                    Log in to create, save and manage your PulseWave playlists.
                </p>
                <button class="mypl-btn-primary" @onclick="GoToLogin">
                    Go to login
                </button>
            </div>
        </div>
    }
    else
    {
        <!-- ERROR / LOADING -->
        @if (!string.IsNullOrEmpty(Error))
        {
            <div class="alert alert-danger mt-2">@Error</div>
        }
        else if (_loading)
        {
            <div class="d-flex align-items-center">
                <div class="spinner-border me-2" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <span>Loading your playlists...</span>
            </div>
        }
        else
        {
            <!-- CREATE PLAYLIST PANEL -->
            @if (ShowCreate)
            {
                <div class="mypl-create-card mypl-glass-card">
                    <div class="mypl-create-header">
                        <div>
                            <h2 class="mypl-card-title">Create a new playlist</h2>
                            <p class="mypl-card-text">
                                Give it a name, vibe and choose if it’s public.
                            </p>
                        </div>
                        <button class="mypl-btn-icon" @onclick="() => ShowCreate = false">✕</button>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Name</label>
                            <input class="form-control"
                                   @bind="NewName"
                                   placeholder="Morning Focus" />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label">Description (optional)</label>
                            <input class="form-control"
                                   @bind="NewDescription"
                                   placeholder="Lo-fi, chill & code waves" />
                        </div>

                        <!-- красивый Public/Private ползунок -->
                        <div class="col-md-3 d-flex align-items-center">
                            <div class="mypl-toggle-wrapper mt-3 mt-md-4">
                                <input type="checkbox"
                                       id="isPublic"
                                       class="mypl-toggle-input"
                                       @bind="NewIsPublic" />

                                <label for="isPublic" class="mypl-toggle-label">
                                    <span class="mypl-toggle-pill">
                                        <span class="mypl-toggle-thumb"></span>
                                    </span>
                                    <span class="mypl-toggle-text">
                                        @(NewIsPublic ? "Public playlist" : "Private playlist")
                                    </span>
                                </label>
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(CreateError))
                    {
                        <div class="alert alert-danger mt-3">@CreateError</div>
                    }

                    <div class="mt-3 d-flex gap-2">
                        <button class="mypl-btn-primary"
                                disabled="@Creating"
                                @onclick="CreateAsync">
                            @(Creating ? "Creating..." : "Create playlist")
                        </button>
                        <button class="btn btn-outline-secondary btn-sm"
                                @onclick="() => ShowCreate = false">
                            Cancel
                        </button>
                    </div>
                </div>
            }

            <!-- LIST OR EMPTY STATE -->
            @if (_items is null || _items.Count == 0)
            {
                <div class="mypl-empty-card mypl-glass-card">
                    <div class="mypl-empty-icon">🎵</div>
                    <h2 class="mypl-card-title">No playlists yet.</h2>
                    <p class="mypl-card-text">
                        Start your first playlist and fill it with the tracks you love.
                    </p>
                    <button class="mypl-btn-primary" @onclick="() => ShowCreate = true">
                        + Create playlist
                    </button>
                </div>
            }
            else
            {
                <div class="mypl-grid">
                    @foreach (var p in _items)
                    {
                        <section class="mypl-card mypl-glass-card"
                                 @onclick="() => OpenDetails(p.Id)">
                            <div class="mypl-card-main">
                                <div class="mypl-card-thumb">
                                    <div class="mypl-card-thumb-inner">
                                        🎧
                                    </div>
                                </div>

                                <div class="mypl-card-body">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h2 class="mypl-card-name">@p.Name</h2>
                                            @if (!string.IsNullOrWhiteSpace(p.Description))
                                            {
                                                <p class="mypl-card-text mb-1">@p.Description</p>
                                            }
                                            <div class="mypl-card-meta">
                                                <span class="mypl-chip">
                                                    @(p.IsPublic ? "Public" : "Private")
                                                </span>
                                                @if (p.SourcePlaylistId is not null)
                                                {
                                                    <span class="mypl-chip">
                                                        Imported • #@p.SourcePlaylistId
                                                    </span>
                                                }
                                            </div>
                                        </div>

                                        <!-- Delete с confirm -->
                                        <button class="mypl-card-delete"
                                                @onclick:stopPropagation="true"
                                                @onclick="() => OnDeleteClick(p.Id)"
                                                disabled="@Deleting">
                                            ✕
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="mypl-card-footer">
                                <span class="mypl-card-footer-text">
                                    Tap to open playlist details
                                </span>
                                <span class="mypl-card-arrow">›</span>
                            </div>
                        </section>
                    }
                </div>
            }
        }
    }
</div>

@code {
    private bool _loading;
    private string? Error;

    private IReadOnlyList<UserPlaylistDto>? _items;

    // create playlist state
    private bool ShowCreate;
    private string NewName { get; set; } = string.Empty;
    private string? NewDescription { get; set; }
    private bool NewIsPublic { get; set; } = true;
    private bool Creating;
    private string? CreateError;

    // delete state
    private bool Deleting;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated)
            return;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        Error = null;
        _loading = true;
        StateHasChanged();

        try
        {
            var page = await Api.GetMyPlaylistsAsync(page: 1, pageSize: 50);
            _items = page.Items;
        }
        catch (Exception ex)
        {
            Error = $"Failed to load playlists: {ex.Message}";
        }

        _loading = false;
        StateHasChanged();
    }

    private async Task CreateAsync()
    {
        CreateError = null;

        if (string.IsNullOrWhiteSpace(NewName))
        {
            CreateError = "Playlist name is required.";
            return;
        }

        Creating = true;
        StateHasChanged();

        var (ok, err) = await Api.CreateUserPlaylistAsync(NewName, NewDescription, NewIsPublic);

        Creating = false;

        if (!ok)
        {
            CreateError = err ?? "Failed to create playlist.";
            StateHasChanged();
            return;
        }

        // clear form & close
        NewName = string.Empty;
        NewDescription = null;
        NewIsPublic = true;
        ShowCreate = false;

        await LoadAsync();
    }

    private async Task OnDeleteClick(int id)
    {
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            "Are you sure you want to delete this playlist?");

        if (!confirmed)
            return;

        await DeleteAsync(id);
    }

    private async Task DeleteAsync(int id)
    {
        Error = null;
        Deleting = true;
        StateHasChanged();

        var err = await Api.DeleteUserPlaylistAsync(id);
        if (!string.IsNullOrEmpty(err))
        {
            Error = err;
        }
        else
        {
            await LoadAsync();
        }

        Deleting = false;
        StateHasChanged();
    }

    private void OpenDetails(int id)
    {
        Nav.NavigateTo($"/my-playlists/{id}");
    }

    private void GoToLogin()
    {
        Nav.NavigateTo("login");
    }
}
