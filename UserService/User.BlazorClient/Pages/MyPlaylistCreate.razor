@page "/my-playlists/new"
@using User.BlazorClient.Services
@inject UserApiClient Api
@inject AuthState Auth
@inject NavigationManager Nav

<div class="container mt-3" style="max-width: 600px;">
    <div class="d-flex align-items-center mb-3">
        <button class="btn btn-link p-0 me-2" @onclick="GoBack">
            ← Back
        </button>
        <h2 class="mb-0">Create playlist</h2>
    </div>

    @if (!Auth.IsAuthenticated)
    {
        <div class="alert alert-warning">
            You need to <a href="login" @onclick="@(e => Nav.NavigateTo("login"))">log in</a> first.
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(Error))
        {
            <div class="alert alert-danger">@Error</div>
        }

        <EditForm Model="@this" OnValidSubmit="OnSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label class="form-label">Name</label>
                <InputText class="form-control" @bind-Value="Name" />
            </div>

            <div class="mb-3">
                <label class="form-label">Description</label>
                <InputTextArea class="form-control" @bind-Value="Description" rows="3" />
            </div>

            <div class="form-check mb-3">
                <InputCheckbox class="form-check-input" @bind-Value="IsPublic" id="isPublicChk" />
                <label class="form-check-label" for="isPublicChk">
                    Public playlist
                </label>
            </div>

            <button class="btn btn-primary" type="submit" disabled="@_submitting">
                @(_submitting ? "Creating..." : "Create")
            </button>
        </EditForm>
    }
</div>

@code {
    // simple form model fields
    public string Name { get; set; } = "";
    public string? Description { get; set; }
    public bool IsPublic { get; set; } = false;

    private string? Error;
    private bool _submitting;

    private async Task OnSubmit()
    {
        Error = null;

        if (string.IsNullOrWhiteSpace(Name))
        {
            Error = "Name is required.";
            return;
        }

        _submitting = true;
        StateHasChanged();

        var (ok, err) = await Api.CreateUserPlaylistAsync(Name, Description, IsPublic);
        if (!ok)
        {
            Error = err ?? "Failed to create playlist.";
            _submitting = false;
            StateHasChanged();
            return;
        }

        Nav.NavigateTo("/my-playlists");
    }

    private void GoBack()
    {
        Nav.NavigateTo("/my-playlists");
    }
}
